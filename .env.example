# Copy this file to .env.local for local work.
#
# Empty values use the defaults baked into the app where defaults exist.
# Never put real secrets, private RPC URLs, seed phrases, private keys, or
# wallet material in this file.

# ---------------------------------------------------------------------------
# Public browser variables
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values are bundled into the frontend and visible to users.
# Use only browser-safe public RPC URLs or non-secret project identifiers here.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_TELEMETRY_ENABLED=

# Public wallet RPC overrides. Leave blank to use code defaults.
NEXT_PUBLIC_PULSECHAIN_RPC_URL=
NEXT_PUBLIC_BSC_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=

# Optional public Ethereum wallet transport overrides.
# These are not used by the server-side Ethereum approval API.
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_ETHEREUM_RPC_URL=

# Public PulseChain explorer API override. Leave blank to use the code default.
NEXT_PUBLIC_PULSECHAIN_EXPLORER_API=

# Desktop/static-only explorer settings for builds without hosted API routes.
# Hosted web deployments should prefer the server-only variables below.
NEXT_PUBLIC_BSC_EXPLORER_API_URL=
NEXT_PUBLIC_BSC_EXPLORER_CHAIN_ID=56
NEXT_PUBLIC_BSC_EXPLORER_API_KEY=
NEXT_PUBLIC_BSCSCAN_API_KEY=

NEXT_PUBLIC_BASE_EXPLORER_API_URL=
NEXT_PUBLIC_BASE_EXPLORER_CHAIN_ID=8453
NEXT_PUBLIC_BASE_EXPLORER_API_KEY=

NEXT_PUBLIC_POLYGON_EXPLORER_API_URL=
NEXT_PUBLIC_POLYGON_EXPLORER_CHAIN_ID=137
NEXT_PUBLIC_POLYGON_EXPLORER_API_KEY=

# ---------------------------------------------------------------------------
# Server-only hosted discovery variables
# ---------------------------------------------------------------------------
# These values are read only by Next.js API routes on the server. Do not expose
# them as NEXT_PUBLIC_* variables.

# BNB Smart Chain discovery through /api/discovery/approvals.
BSC_EXPLORER_API_URL=
BSC_EXPLORER_CHAIN_ID=56
BSC_EXPLORER_API_KEY=

# Base discovery through /api/discovery/approvals.
BASE_EXPLORER_API_URL=
BASE_EXPLORER_CHAIN_ID=8453
BASE_EXPLORER_API_KEY=

# Polygon discovery through /api/discovery/approvals.
POLYGON_EXPLORER_API_URL=
POLYGON_EXPLORER_CHAIN_ID=137
POLYGON_EXPLORER_API_KEY=

# Ethereum Mainnet discovery through /api/ethereum/approvals.
MAINNET_RPC_URL=
ETHEREUM_RPC_URL=
ETHEREUM_EXPLORER_API_URL=
ETHERSCAN_API_KEY=

# Arbitrum One discovery through /api/arbitrum/approvals.
ARBITRUM_ONE_RPC_URL=
ARBITRUM_RPC_URL=
ARBITRUM_EXPLORER_API_URL=
ARBITRUM_EXPLORER_CHAIN_ID=42161
ARBISCAN_API_KEY=

# Optimism / OP Mainnet discovery through /api/optimism/approvals.
OPTIMISM_RPC_URL=
OPTIMISM_MAINNET_RPC_URL=
OP_MAINNET_RPC_URL=
OPTIMISM_EXPLORER_API_URL=
OPTIMISM_EXPLORER_CHAIN_ID=10
OPTIMISM_EXPLORER_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=

# HyperEVM discovery through /api/hyperevm/approvals.
HYPEREVM_RPC_URL=
HYPEREVM_MAINNET_RPC_URL=
HYPERLIQUID_EVM_RPC_URL=
HYPEREVM_EXPLORER_API_URL=
HYPEREVM_EXPLORER_CHAIN_ID=999
HYPEREVM_EXPLORER_API_KEY=
HYPEREVM_ETHERSCAN_API_KEY=
