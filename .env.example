NEXT_PUBLIC_WORLDCHAIN_EXPLORER_API_URL=
NEXT_PUBLIC_WORLDCHAIN_EXPLORER_CHAIN_ID=480
NEXT_PUBLIC_ROBINHOOD_EXPLORER_API_URL=

# ---------------------------------------------------------------------------
# Server-only hosted discovery variables
# ---------------------------------------------------------------------------
# These values are read only by Next.js API routes on the server. Do not expose
# them as NEXT_PUBLIC_* variables.

# Optional PulseChain gas tracker advisory tiers. The tracker still uses
# PulseChain RPC as the current-block source of truth.
OWLRACLE_API_KEY=

# Optional server-side gas tracker RPC overrides. Leave blank to use public
# code defaults or existing NEXT_PUBLIC_* fallbacks.
# Hosted PulseChain approval discovery tries PulseScan, then
# PULSECHAIN_DISCOVERY_RPC_URL/PULSECHAIN_RPC_URL/PULSECHAIN_MAINNET_RPC_URL,
# then OtherScan transaction receipts, the code default public PulseChain RPC,
# and finally OtherScan RPC.
PULSECHAIN_DISCOVERY_RPC_URL=
PULSECHAIN_OTHERSCAN_RPC_URL=
PULSECHAIN_RPC_URL=
PULSECHAIN_MAINNET_RPC_URL=
BSC_RPC_URL=
BSC_MAINNET_RPC_URL=
BASE_RPC_URL=
BASE_MAINNET_RPC_URL=
POLYGON_RPC_URL=
POLYGON_MAINNET_RPC_URL=
SONIC_RPC_URL=
SONIC_MAINNET_RPC_URL=
AVALANCHE_RPC_URL=
AVALANCHE_C_CHAIN_RPC_URL=
AVALANCHE_MAINNET_RPC_URL=
MANTLE_RPC_URL=
MANTLE_MAINNET_RPC_URL=
CELO_RPC_URL=
CELO_MAINNET_RPC_URL=
GNOSIS_RPC_URL=
GNOSIS_MAINNET_RPC_URL=
UNICHAIN_RPC_URL=
UNICHAIN_MAINNET_RPC_URL=
WORLDCHAIN_RPC_URL=
WORLDCHAIN_MAINNET_RPC_URL=
ROBINHOOD_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=
LINEA_RPC_URL=
LINEA_MAINNET_RPC_URL=
BLAST_RPC_URL=
BLAST_MAINNET_RPC_URL=
BERACHAIN_RPC_URL=
BERACHAIN_MAINNET_RPC_URL=
CELO_RPC_URL=
CELO_MAINNET_RPC_URL=
GNOSIS_RPC_URL=
GNOSIS_MAINNET_RPC_URL=
UNICHAIN_RPC_URL=
UNICHAIN_MAINNET_RPC_URL=
WORLDCHAIN_RPC_URL=
WORLDCHAIN_MAINNET_RPC_URL=
ROBINHOOD_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=

# BNB Smart Chain discovery through /api/discovery/approvals.
BSC_EXPLORER_API_URL=
BSC_EXPLORER_CHAIN_ID=56
BSC_EXPLORER_API_KEY=

# Base discovery through /api/discovery/approvals.
BASE_EXPLORER_API_URL=
BASE_EXPLORER_CHAIN_ID=8453
BASE_EXPLORER_API_KEY=

# Polygon discovery through /api/discovery/approvals.
POLYGON_EXPLORER_API_URL=
POLYGON_EXPLORER_CHAIN_ID=137
POLYGON_EXPLORER_API_KEY=

# Sonic discovery through /api/discovery/approvals.
SONIC_EXPLORER_API_URL=
SONIC_EXPLORER_CHAIN_ID=146
SONIC_EXPLORER_API_KEY=

# Avalanche C-Chain discovery through /api/discovery/approvals.
AVALANCHE_EXPLORER_API_URL=
AVALANCHE_EXPLORER_CHAIN_ID=43114
AVALANCHE_EXPLORER_API_KEY=

# Mantle discovery through /api/discovery/approvals.
MANTLE_EXPLORER_API_URL=
MANTLE_EXPLORER_CHAIN_ID=5000
MANTLE_EXPLORER_API_KEY=

# Linea, Blast, Berachain, Celo, Gnosis, Unichain, and World Chain discovery
# through /api/discovery/approvals. These Etherscan API V2 chains can share
# ETHERSCAN_API_KEY. Optional chain-specific keys override the shared key.
LINEA_EXPLORER_API_URL=
LINEA_EXPLORER_CHAIN_ID=59144
LINEA_EXPLORER_API_KEY=
BLAST_EXPLORER_API_URL=
BLAST_EXPLORER_CHAIN_ID=81457
BLAST_EXPLORER_API_KEY=
BERACHAIN_EXPLORER_API_URL=
BERACHAIN_EXPLORER_CHAIN_ID=80094
BERACHAIN_EXPLORER_API_KEY=
CELO_EXPLORER_API_URL=
CELO_EXPLORER_CHAIN_ID=42220
CELO_EXPLORER_API_KEY=
GNOSIS_EXPLORER_API_URL=
GNOSIS_EXPLORER_CHAIN_ID=100
GNOSIS_EXPLORER_API_KEY=
UNICHAIN_EXPLORER_API_URL=
UNICHAIN_EXPLORER_CHAIN_ID=130
UNICHAIN_EXPLORER_API_KEY=
WORLDCHAIN_EXPLORER_API_URL=
WORLDCHAIN_EXPLORER_CHAIN_ID=480
WORLDCHAIN_EXPLORER_API_KEY=

# Robinhood Chain discovery through /api/discovery/approvals.
# This uses Robinhood Blockscout and does not require an Etherscan API key.
ROBINHOOD_EXPLORER_API_URL=

# Ethereum Mainnet discovery through /api/ethereum/approvals and server-side
# gas samples through /api/gas.
MAINNET_RPC_URL=
ETHEREUM_RPC_URL=
ETHEREUM_EXPLORER_API_URL=
ETHERSCAN_API_KEY=

# Arbitrum One discovery through /api/arbitrum/approvals and server-side gas
# samples through /api/gas.
ARBITRUM_ONE_RPC_URL=
ARBITRUM_RPC_URL=
ARBITRUM_EXPLORER_API_URL=
ARBITRUM_EXPLORER_CHAIN_ID=42161
ARBISCAN_API_KEY=

# Optimism / OP Mainnet discovery through /api/optimism/approvals and
# server-side gas samples through /api/gas.
OPTIMISM_RPC_URL=
OPTIMISM_MAINNET_RPC_URL=
OP_MAINNET_RPC_URL=
OPTIMISM_EXPLORER_API_URL=
OPTIMISM_EXPLORER_CHAIN_ID=10
OPTIMISM_EXPLORER_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=

# HyperEVM discovery through /api/hyperevm/approvals and server-side gas samples
# through /api/gas.
HYPEREVM_RPC_URL=
HYPEREVM_MAINNET_RPC_URL=
HYPERLIQUID_EVM_RPC_URL=
HYPEREVM_EXPLORER_API_URL=
HYPEREVM_EXPLORER_CHAIN_ID=999
HYPEREVM_EXPLORER_API_KEY=
HYPEREVM_ETHERSCAN_API_KEY=
