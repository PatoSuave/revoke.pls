# Optional override for the PulseChain RPC endpoint used by both the wagmi
# transport and viem chain config. Defaults to https://rpc.pulsechain.com.
NEXT_PUBLIC_PULSECHAIN_RPC_URL=

# Optional override for the BSC / BNB Smart Chain RPC endpoint used by both
# the wagmi transport and viem chain config. Defaults to the public BNB Chain
# RPC at https://bsc-dataseed.bnbchain.org. Use a browser-safe managed/public
# RPC URL for production reliability. Do not put secret-key or private RPC URLs
# in NEXT_PUBLIC_* variables. Historical approval discovery uses Etherscan API
# V2 logs for BSC.
NEXT_PUBLIC_BSC_RPC_URL=

# Optional override for the Base Mainnet RPC endpoint used by both the wagmi
# transport and viem chain config. Defaults to the public Base RPC at
# https://mainnet.base.org. Use a browser-safe managed/public RPC URL for
# production reliability. Do not put secret-key or private RPC URLs in
# NEXT_PUBLIC_* variables. Historical approval discovery uses Etherscan API V2
# logs for Base.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# WalletConnect Cloud project ID.
# Obtain a free one at https://cloud.reown.com (formerly WalletConnect Cloud).
# When set, adds QR pairing for mobile wallets alongside injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional override for the Blockscout-compatible PulseChain explorer API
# used by the approval discovery pipeline. Defaults to
# https://api.scan.pulsechain.com/api. Must implement the Etherscan-compatible
# ?module=logs&action=getLogs endpoint with topic0 / topic1 filters.
NEXT_PUBLIC_PULSECHAIN_EXPLORER_API=

# Optional override for the Etherscan API V2 logs endpoint used by BSC
# historical approval discovery. BscScan remains the UI explorer for links, but
# BSC log reads use Etherscan API V2 with chainid=56. The old BscScan V1
# endpoint https://api.bscscan.com/api is deprecated for this logs flow.
NEXT_PUBLIC_BSC_EXPLORER_API_URL=https://api.etherscan.io/v2/api

# Etherscan API V2 chain id for BNB Smart Chain logs. Keep this at 56.
NEXT_PUBLIC_BSC_EXPLORER_CHAIN_ID=56

# Preferred BSC historical logs API key. Use an Etherscan API V2 key with BNB
# Smart Chain access. Do not commit real keys.
NEXT_PUBLIC_BSC_EXPLORER_API_KEY=

# Deprecated fallback key name retained for compatibility with older deploys.
# Prefer NEXT_PUBLIC_BSC_EXPLORER_API_KEY.
NEXT_PUBLIC_BSCSCAN_API_KEY=

# Optional override for the Etherscan API V2 logs endpoint used by Base
# historical approval discovery. BaseScan remains the UI explorer for links,
# but Base log reads use Etherscan API V2 with chainid=8453.
NEXT_PUBLIC_BASE_EXPLORER_API_URL=https://api.etherscan.io/v2/api

# Etherscan API V2 chain id for Base Mainnet logs. Keep this at 8453.
NEXT_PUBLIC_BASE_EXPLORER_CHAIN_ID=8453

# Base historical logs API key. Use an Etherscan API V2 key with Base Mainnet
# access. Do not commit real keys.
NEXT_PUBLIC_BASE_EXPLORER_API_KEY=

# Server-only Ethereum mainnet read API foundation.
# Used by /api/ethereum/approvals for read-only discovery and live validation.
# Ethereum revoke remains wallet-side only; do not expose the Etherscan key as
# NEXT_PUBLIC_ and do not add any server-side signing or transaction relaying.
MAINNET_RPC_URL=
# ETHEREUM_RPC_URL is also accepted as an RPC fallback name.
ETHEREUM_RPC_URL=
# Optional server-only Etherscan API V2 endpoint override.
ETHEREUM_EXPLORER_API_URL=https://api.etherscan.io/v2/api
# Server-only Etherscan API key for Ethereum Mainnet approval discovery.
ETHERSCAN_API_KEY=

# Canonical public URL of the deployment (e.g. https://pulserevoke.com).
# Used by SEO metadata, Open Graph/Twitter card absolute URLs, and the
# canonical tag.
# Use a full URL with https://. Host-only values are normalized defensively.
# Set this to your own origin for preview/staging deploys so previews do not
# advertise the production canonical.
NEXT_PUBLIC_SITE_URL=https://pulserevoke.com
