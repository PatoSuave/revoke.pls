NEXT_PUBLIC_CELO_EXPLORER_API_URL=
NEXT_PUBLIC_CELO_EXPLORER_CHAIN_ID=42220

NEXT_PUBLIC_GNOSIS_EXPLORER_API_URL=
NEXT_PUBLIC_GNOSIS_EXPLORER_CHAIN_ID=100

