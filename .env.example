# Optional override for the PulseChain RPC endpoint used by both the wagmi
# transport and viem chain config. Defaults to https://rpc.pulsechain.com.
NEXT_PUBLIC_PULSECHAIN_RPC_URL=

# Optional override for the BSC / BNB Smart Chain RPC endpoint used by both
# the wagmi transport and viem chain config. Defaults to the public BNB Chain
# RPC at https://bsc-dataseed.bnbchain.org. Use a browser-safe managed/public
# RPC URL for production reliability. Do not put secret-key or private RPC URLs
# in NEXT_PUBLIC_* variables. Historical approval discovery uses Etherscan API
# V2 logs for BSC.
NEXT_PUBLIC_BSC_RPC_URL=

# Optional override for the Base Mainnet RPC endpoint used by both the wagmi
# transport and viem chain config. Defaults to the public Base RPC at
# https://mainnet.base.org. Use a browser-safe managed/public RPC URL for
# production reliability. Do not put secret-key or private RPC URLs in
# NEXT_PUBLIC_* variables. Historical approval discovery uses Etherscan API V2
# logs for Base.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Optional override for the Polygon RPC endpoint used by both the wagmi
# transport and viem chain config. Defaults to the public Polygon RPC at
# https://polygon.drpc.org. Use a browser-safe managed/public RPC URL for
# production reliability. Do not put secret-key or private RPC URLs in
# NEXT_PUBLIC_* variables. Historical approval discovery uses Etherscan API V2
# logs for Polygon.
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon.drpc.org

# WalletConnect Cloud project ID.
# Obtain a free one at https://cloud.reown.com (formerly WalletConnect Cloud).
# When set, adds QR pairing for mobile wallets alongside injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional override for the Blockscout-compatible PulseChain explorer API
# used by the approval discovery pipeline. Defaults to
# https://api.scan.pulsechain.com/api. Must implement the Etherscan-compatible
# ?module=logs&action=getLogs endpoint with topic0 / topic1 filters.
NEXT_PUBLIC_PULSECHAIN_EXPLORER_API=

# Optional public override for the Etherscan API V2 logs endpoint used by
# desktop/static BSC historical approval discovery. Hosted web deployments use
# the server-only BSC_EXPLORER_* values below.
NEXT_PUBLIC_BSC_EXPLORER_API_URL=https://api.etherscan.io/v2/api

# Public desktop/static Etherscan API V2 chain id for BNB Smart Chain logs.
NEXT_PUBLIC_BSC_EXPLORER_CHAIN_ID=56

# Public desktop/static fallback key. Hosted web deployments should leave this
# unset and use BSC_EXPLORER_API_KEY or ETHERSCAN_API_KEY server-side instead.
NEXT_PUBLIC_BSC_EXPLORER_API_KEY=

# Deprecated fallback key name retained for compatibility with older deploys.
# Prefer NEXT_PUBLIC_BSC_EXPLORER_API_KEY.
NEXT_PUBLIC_BSCSCAN_API_KEY=

# Server-only BSC logs API foundation for hosted web deployments.
BSC_EXPLORER_API_URL=https://api.etherscan.io/v2/api
BSC_EXPLORER_CHAIN_ID=56
# ETHERSCAN_API_KEY is also accepted as a fallback.
BSC_EXPLORER_API_KEY=

# Optional public override for desktop/static Base historical discovery. Hosted
# web deployments use the server-only BASE_EXPLORER_* values below.
NEXT_PUBLIC_BASE_EXPLORER_API_URL=https://api.etherscan.io/v2/api

# Public desktop/static Etherscan API V2 chain id for Base Mainnet logs.
NEXT_PUBLIC_BASE_EXPLORER_CHAIN_ID=8453

# Public desktop/static fallback key. Hosted web deployments should leave this
# unset and use BASE_EXPLORER_API_KEY or ETHERSCAN_API_KEY server-side instead.
NEXT_PUBLIC_BASE_EXPLORER_API_KEY=

# Server-only Base logs API foundation for hosted web deployments.
BASE_EXPLORER_API_URL=https://api.etherscan.io/v2/api
BASE_EXPLORER_CHAIN_ID=8453
# ETHERSCAN_API_KEY is also accepted as a fallback.
BASE_EXPLORER_API_KEY=

# Optional public override for desktop/static Polygon historical discovery.
# Hosted web deployments use the server-only POLYGON_EXPLORER_* values below.
NEXT_PUBLIC_POLYGON_EXPLORER_API_URL=https://api.etherscan.io/v2/api

# Public desktop/static Etherscan API V2 chain id for Polygon Mainnet logs.
NEXT_PUBLIC_POLYGON_EXPLORER_CHAIN_ID=137

# Public desktop/static fallback key. Hosted web deployments should leave this
# unset and use POLYGON_EXPLORER_API_KEY or ETHERSCAN_API_KEY server-side.
NEXT_PUBLIC_POLYGON_EXPLORER_API_KEY=

# Server-only Polygon logs API foundation for hosted web deployments.
POLYGON_EXPLORER_API_URL=https://api.etherscan.io/v2/api
POLYGON_EXPLORER_CHAIN_ID=137
# ETHERSCAN_API_KEY is also accepted as a fallback.
POLYGON_EXPLORER_API_KEY=

# Server-only Ethereum mainnet read API foundation.
# Used by /api/ethereum/approvals for read-only discovery and live validation.
# Ethereum revoke remains wallet-side only; do not expose the Etherscan key as
# NEXT_PUBLIC_ and do not add any server-side signing or transaction relaying.
MAINNET_RPC_URL=
# ETHEREUM_RPC_URL is also accepted as an RPC fallback name.
ETHEREUM_RPC_URL=
# Optional server-only Etherscan API V2 endpoint override.
ETHEREUM_EXPLORER_API_URL=https://api.etherscan.io/v2/api
# Server-only Etherscan API key for Ethereum Mainnet approval discovery.
ETHERSCAN_API_KEY=

# Server-only Arbitrum One read-only API foundation.
# Used by /api/arbitrum/approvals for approval discovery and live validation.
# Arbitrum row-level revoke is wallet-side only for live-verified ERC-20 and
# NFT rows. Keep managed RPC URLs and API keys out of NEXT_PUBLIC_* variables.
ARBITRUM_ONE_RPC_URL=
# ARBITRUM_RPC_URL is also accepted as an RPC fallback name.
ARBITRUM_RPC_URL=
# Optional server-only Etherscan API V2 endpoint override for Arbitrum logs.
ARBITRUM_EXPLORER_API_URL=https://api.etherscan.io/v2/api
# Etherscan-compatible API V2 chain id for Arbitrum One logs. Keep this at 42161.
ARBITRUM_EXPLORER_CHAIN_ID=42161
# Server-only Arbiscan/Etherscan-compatible API key for Arbitrum approval discovery.
ARBISCAN_API_KEY=

# Server-only Optimism API foundation.
# Used by /api/optimism/approvals for approval discovery and live validation.
# Optimism revoke is limited to verified ERC-20 and NFT rows; batch revoke is
# not enabled. Keep managed RPC URLs and API keys out of NEXT_PUBLIC_* variables.
OPTIMISM_RPC_URL=
# Optional RPC fallback names accepted by the server route.
OPTIMISM_MAINNET_RPC_URL=
OP_MAINNET_RPC_URL=
# Optional server-only Etherscan API V2 endpoint override for Optimism logs.
OPTIMISM_EXPLORER_API_URL=https://api.etherscan.io/v2/api
# Etherscan API V2 chain id for OP Mainnet logs. Keep this at 10.
OPTIMISM_EXPLORER_CHAIN_ID=10
# Server-only Etherscan API V2 key for Optimism approval discovery.
# ETHERSCAN_API_KEY is also accepted as a fallback.
OPTIMISM_EXPLORER_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=

# Server-only HyperEVM API foundation.
# Used by /api/hyperevm/approvals for approval discovery and live validation.
# HyperEVM revoke is limited to verified ERC-20 and NFT rows; batch revoke is
# not enabled. Gas is paid in HYPE. Keep managed RPC URLs and API keys out of
# NEXT_PUBLIC_* variables.
HYPEREVM_RPC_URL=
# Optional RPC fallback names accepted by the server route.
HYPEREVM_MAINNET_RPC_URL=
HYPERLIQUID_EVM_RPC_URL=
# Optional server-only Etherscan API V2 endpoint override for HyperEVM logs.
HYPEREVM_EXPLORER_API_URL=https://api.etherscan.io/v2/api
# Etherscan API V2 chain id for HyperEVM logs. Keep this at 999.
HYPEREVM_EXPLORER_CHAIN_ID=999
# Server-only Etherscan API V2 key for HyperEVM approval discovery.
# ETHERSCAN_API_KEY and BSC_EXPLORER_API_KEY are also accepted as fallbacks.
HYPEREVM_EXPLORER_API_KEY=
HYPEREVM_ETHERSCAN_API_KEY=

# Canonical public URL of the deployment (e.g. https://pulserevoke.com).
# Used by SEO metadata, Open Graph/Twitter card absolute URLs, and the
# canonical tag.
# Use a full URL with https://. Host-only values are normalized defensively.
# Set this to your own origin for preview/staging deploys so previews do not
# advertise the production canonical.
NEXT_PUBLIC_SITE_URL=https://pulserevoke.com
